# Identificadores de disco y línea de comandos del kernel. Los leen (con `.`)
# infra/image/scripts/build-image.sh y build-device-update.sh: un solo lugar para cambiarlos.

# Identificadores fijos: la imagen es la misma en cada build y extlinux/fstab no cambian.
DISK_ID=0x52474253          # "RGBS"
BOOT_PARTUUID=52474253-01
ROOT_PARTUUID=52474253-02
ROOT_FSUUID=7a1c0b3e-2b20-4c5a-9e11-52474253a001
BOOT_VOLID=52474253

CMDLINE_BASE="root=PARTUUID=$ROOT_PARTUUID rootfstype=ext4 rootwait rw console=ttyS2,1500000n8 console=tty0 consoleblank=0 panic=0"

# Arranque normal, con splash (ADR 0015):
# - loglevel=4: en las consolas (pantalla y ttyS2) solo errores y peores. dmesg y /boot/logs tienen todo.
#   Tiene que ser MAYOR que CONFIG_CONSOLE_LOGLEVEL_QUIET (3 en config.fragment): con un nivel menor o
#   igual, fbcon no dibuja el logo. Por lo mismo, no usar `quiet` (pone el nivel en QUIET).
# - vt.global_cursor_default=0: sin cursor parpadeando debajo del logo.
# - fbcon=logo-count:1: un solo logo (por defecto, uno por CPU).
# - systemd.show_status=auto: systemd solo escribe si algo falla o demora.
CMDLINE="$CMDLINE_BASE loglevel=4 vt.global_cursor_default=0 fbcon=logo-count:1 systemd.show_status=auto udev.log_level=3"

# Entrada "arch-verbose" de extlinux.conf: todos los mensajes, como la imagen original (sin logo).
CMDLINE_VERBOSE="$CMDLINE_BASE loglevel=7 systemd.show_status=1"

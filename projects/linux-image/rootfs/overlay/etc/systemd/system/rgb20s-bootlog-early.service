[Unit]
Description=RGB20S: marca en /boot/logs de que el kernel llegó a userspace
DefaultDependencies=no
After=boot.mount
Requires=boot.mount
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/rgb20s/bootlog.sh early

[Install]
WantedBy=sysinit.target

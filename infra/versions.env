# Versiones fijadas del entorno de build. Las leen el justfile y los scripts de infra/.
# Cambiar una versión acá = reconstruir las imágenes (`just images`).

# Base Debian: dArkOS se construye sobre Debian trixie (Makefile de dArkOS: DEBIAN_CODE_NAME ?= trixie).
# Digest del índice multi-arquitectura de debian:trixie-20261104 (sirve para amd64 y arm64).
DEBIAN_IMAGE=debian:trixie-20261104@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6

# Fecha de snapshot.debian.org: congela las versiones de los paquetes apt (libsdl2-dev, libasound2-dev, gcc...).
DEBIAN_SNAPSHOT=20261104T000000Z

# Rust: toolchain y rustup-init con su sha256 (https://static.rust-lang.org/rustup/archive/<ver>/<triple>/rustup-init.sha256).
RUST_VERSION=1.99.0
RUSTUP_VERSION=1.29.3
RUSTUP_SHA256_AMD64=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
RUSTUP_SHA256_ARM64=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282

# Datos de la consola (sin verificar hasta el inventario de device-ops):
# dArkOS actual = Debian trixie -> glibc 2.41; SDL2 2.32.10 compilada por dArkOS (commit 5d24957 de libsdl-org/SDL).
# ArkOS original = Ubuntu 19.10 -> glibc 2.30 (sin verificar).
CONSOLE_GLIBC_MAX=2.41
